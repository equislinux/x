[Unit]
Description=x unattended installer (cidata)
ConditionPathExists=/root/x-installer/autoinstall.sh
After=systemd-udevd.service pacman-init.service x-keyring.service
Wants=x-keyring.service

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /root/x-installer/autoinstall.sh
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
