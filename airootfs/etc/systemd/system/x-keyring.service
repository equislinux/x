[Unit]
Description=Prepare the native xpm GnuPG keyring
ConditionPathExists=/etc/pacman.d/x-repo.pub
ConditionPathExists=/usr/share/pacman/keyrings/archlinux.gpg

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/x-repo-key
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
