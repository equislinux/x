#!/usr/bin/env bash
set -euo pipefail

# Prepare the native xpm GnuPG keyring (no pacman tools).
# The live service and install.sh both call this idempotently. Set XPM_GPGDIR
# to prepare the target keyring instead of the live one.
GPGDIR="${XPM_GPGDIR:-/etc/xpm/gnupg}"
ARCH_KEY=/usr/share/pacman/keyrings/archlinux.gpg
ARCH_TRUST=/usr/share/pacman/keyrings/archlinux-trusted
X_KEY=/etc/pacman.d/x-repo.pub

for key in "$ARCH_KEY" "$X_KEY"; do
    [[ -f "$key" ]] || { echo "x-repo-key: $key is missing" >&2; exit 1; }
done

install -d -m 700 "$GPGDIR"
if command -v flock >/dev/null 2>&1; then
    exec 9>"${XPM_KEYRING_LOCK:-/run/xpm-keyring.lock}"
    flock 9
fi

if ! gpg --batch --homedir "$GPGDIR" --import "$ARCH_KEY" "$X_KEY" >/dev/null 2>&1; then
    echo "x-repo-key: could not import the Arch/X keys into $GPGDIR" >&2
    exit 1
fi
if [[ -f "$ARCH_TRUST" ]]; then
    gpg --batch --homedir "$GPGDIR" --import-ownertrust "$ARCH_TRUST" >/dev/null 2>&1 || true
fi

X_FPR="$(LC_ALL=C gpg --with-colons --show-keys "$X_KEY" 2>/dev/null | awk -F: '/^fpr:/{print $10; exit}')"
if [[ -z "$X_FPR" ]]; then
    echo "x-repo-key: cannot resolve the [x] key fingerprint" >&2
    exit 1
fi
printf '%s:6:\n' "$X_FPR" | gpg --batch --homedir "$GPGDIR" --import-ownertrust >/dev/null 2>&1 || true
gpg --batch --homedir "$GPGDIR" --check-trustdb >/dev/null 2>&1 || true
if ! gpg --batch --homedir "$GPGDIR" --list-keys "$X_FPR" >/dev/null 2>&1; then
    echo "x-repo-key: the [x] key is not present in $GPGDIR" >&2
    exit 1
fi
